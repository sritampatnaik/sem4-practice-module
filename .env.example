# Required: OpenAI API key for all five METS agents
OPENAI_API_KEY=

# Supabase (server only — never use NEXT_PUBLIC_ for the secret)
# Project: Sem 4 Practice Module
# Dashboard: https://supabase.com/dashboard/project/psjxfthrmqegxotokkdf
SUPABASE_URL=https://psjxfthrmqegxotokkdf.supabase.co
# Create-account / sign-in need a public key (publishable or legacy anon JWT).
# Do not paste these into SUPABASE_SERVICE_ROLE_KEY — Auth Admin rejects
# non-JWT Bearers with "This endpoint requires a valid Bearer token".
SUPABASE_PUBLISHABLE_KEY=
# SUPABASE_ANON_KEY=
# Optional privileged key for evals / RLS bypass (service_role JWT or sb_secret_).
# SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_SECRET_KEY=

# Optional model override for the tutor (default gpt-4o)
OPENAI_MODEL=gpt-4o

# Gemini (eval model picker on /evals/scores)
GOOGLE_GENERATIVE_AI_API_KEY=
# GEMINI_API_KEY is accepted as an alias

# Optional Langflow (prompt logging / flow traces)
# Start with: docker compose -f langflow/docker-compose.yml up
LANGFLOW_URL=http://localhost:7860
LANGFLOW_API_KEY=
LANGFLOW_LOGGER_FLOW_ID=

# Optional Guardrail parent/tutor email on a hit (in-app alerts still store without this)
# METS_ADMIN_EMAILS is notify-only — it does not open /admin.
METS_ADMIN_EMAILS=
METS_PARENT_NOTIFY_EMAIL=
# Optional Resend (leave unset to keep alerts in-app only)
# RESEND_API_KEY=
# RESEND_FROM=

# Optional Langfuse (sync catalog with npm run langfuse:seed-evals)
# CLI reads LANGFUSE_HOST; LANGFUSE_BASE_URL is accepted as an alias.
LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_BASE_URL=[REDACTED]
LANGFUSE_HOST=[REDACTED]
