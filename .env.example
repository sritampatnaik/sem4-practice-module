# Required: OpenAI API key for all five METS agents
OPENAI_API_KEY=

# Optional model override (default gpt-4o)
OPENAI_MODEL=gpt-4o

# Optional Langflow (prompt logging / flow traces)
# Start with: docker compose -f langflow/docker-compose.yml up
LANGFLOW_URL=http://localhost:7860
LANGFLOW_API_KEY=
LANGFLOW_LOGGER_FLOW_ID=

# Optional Langfuse (eval datasets / judges). seed with: node langfuse/evals/seed.mjs
# CLI reads LANGFUSE_HOST; LANGFUSE_BASE_URL is accepted as an alias.
LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_BASE_URL=https://us.cloud.langfuse.com
LANGFUSE_HOST=https://us.cloud.langfuse.com
