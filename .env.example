# Required: OpenAI API key for all five METS agents
OPENAI_API_KEY=

# Supabase (server only — never use NEXT_PUBLIC_ for the secret)
# Project: Sem 4 Practice Module
# Dashboard: https://supabase.com/dashboard/project/psjxfthrmqegxotokkdf
SUPABASE_URL=https://psjxfthrmqegxotokkdf.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
# Optional alias for the Dashboard "secret" key (sb_secret_...)
# SUPABASE_SECRET_KEY=
# Optional fallback when the service role is unset: Auth uses the
# publishable/anon key, and data uses the signed-in user's JWT + RLS.
# SUPABASE_ANON_KEY=
# SUPABASE_PUBLISHABLE_KEY=

# Optional model override for the tutor (default gpt-4o)
OPENAI_MODEL=gpt-4o

# Gemini (eval model picker on /evals/scores)
GOOGLE_GENERATIVE_AI_API_KEY=
# GEMINI_API_KEY is accepted as an alias

# Optional Langflow (prompt logging / flow traces)
# Start with: docker compose -f langflow/docker-compose.yml up
LANGFLOW_URL=http://localhost:7860
LANGFLOW_API_KEY=
LANGFLOW_LOGGER_FLOW_ID=

# Optional Langfuse (sync catalog with npm run langfuse:seed-evals)
# CLI reads LANGFUSE_HOST; LANGFUSE_BASE_URL is accepted as an alias.
LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_BASE_URL=[REDACTED]
LANGFUSE_HOST=[REDACTED]
